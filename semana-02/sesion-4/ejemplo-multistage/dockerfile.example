# --- ETAPA 1: Base común ---
    FROM node:22-alpine AS base
    WORKDIR /app
    COPY package.json package-lock.json ./
    
    # --- ETAPA 2: Desarrollo (con hot-reload y devDependencies) ---
    FROM base AS development
    ENV NODE_ENV=development
    # package-lock.json fija las versiones. --ignore-scripts no corre scripts de los paquetes.
    RUN npm ci --ignore-scripts
    COPY . .
    CMD ["npm", "run", "dev"]
    
    # --- ETAPA 3: Pruebas / Testing (ejecuta tests unitarios o linters) ---
    FROM development AS test
    ENV NODE_ENV=test
    RUN npm run lint
    CMD ["npm", "test"]
    
    # --- ETAPA 4: Compilación (genera el código final) ---
    FROM development AS builder
    RUN npm run build
    # Elimina dependencias de desarrollo para dejar solo lo necesario
    RUN npm prune --production
    
    # --- ETAPA 5: Producción (imagen final mínima y segura) ---
    FROM node:22-alpine AS production
    ENV NODE_ENV=production
    WORKDIR /app
    
    # Usamos un usuario sin privilegios de root por seguridad
    USER node
    
    # Copiamos solo las dependencias de producción y el código compilado
    COPY --from=builder --chown=node:node /app/node_modules ./node_modules
    COPY --from=builder --chown=node:node /app/dist ./dist
    COPY --from=builder --chown=node:node /app/package.json ./
    
    EXPOSE 3000
    CMD ["node", "dist/main.js"]
    